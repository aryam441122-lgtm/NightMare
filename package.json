{
  "name": "sf1-boost-tool",
  "version": "8.8.3",
  "description": "SF1 Boost Tool - Discord Boost Manager",
  "main": "main.js",
  "author": "ITs LUX ⎋ (5zz0) — .gg/SF1",

  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:dir": "electron-builder --win dir",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },

  "dependencies": {
    "ws": "^8.18.0"
  },

  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.sf1.boosttool",
    "productName": "SF1 Boost Tool",

    "directories": {
      "output": "release"
    },

    "files": [
      "main.js",
      "preload.js",
      "node_modules/**/*",
      "assets/**/*"
    ],

    "asar": true,

    "win": {
      "icon": "assets/icon.ico",

      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],

      "artifactName": "${productName}-Setup-${version}.${ext}"
    },

    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SF1 Boost Tool"
    }
  }
}
